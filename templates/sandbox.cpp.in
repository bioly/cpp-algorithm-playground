//
// "check.h" gives you CHECK(...) like the exercises use (optional).
#include <algorithm>
#include <iostream>
#include <string>
#include <vector>

#include "check.h"

int main() {
    // A vector, a lambda and an algorithm in four lines.
    std::vector<int> numbers = {5, 3, 8, 1};
    std::sort(numbers.begin(), numbers.end(), [](int a, int b) { return a > b; });  // biggest first

    for (int n : numbers) std::cout << n << ' ';
    std::cout << '\n';

    CHECK(numbers.front() == 8);
    CHECK(numbers.back() == 1);

    std::cout << (refresher::AllChecksPassed() ? "all checks passed" : "SOME CHECKS FAILED") << '\n';
    return refresher::AllChecksPassed() ? 0 : 1;
}
